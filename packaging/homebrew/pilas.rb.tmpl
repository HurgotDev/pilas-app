# Homebrew cask template. `node scripts/release.mjs cask` fills it in the
# release workflow and the result is published to HurgotDev/homebrew-tap.
cask "pilas" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/HurgotDev/pilas-app/releases/download/v#{version}/Pilas_#{version}_universal.dmg"
  name "Pilas"
  desc "Notch mascot that tells you when Claude Code needs you"
  homepage "https://github.com/HurgotDev/pilas-app"

  # Pilas updates itself (tauri-plugin-updater): Homebrew must not overwrite it.
  auto_updates true
  depends_on macos: ">= :ventura"

  app "Pilas.app"

  # The app is neither Apple-signed nor notarized: drop the quarantine flag
  # so macOS does not block the first launch.
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/Pilas.app"]
  end

  zap trash: [
    "~/Library/Application Support/Pilas",
    "~/Library/LaunchAgents/dev.pilas.app.plist",
  ]
end
