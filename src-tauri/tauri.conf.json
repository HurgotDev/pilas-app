{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pilas",
  "version": "0.2.0",
  "identifier": "dev.pilas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "island",
        "title": "Pilas",
        "width": 180,
        "height": 6,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3RDVENEFDRkNGQjQyODMKUldTRFF2djhyTlRWWjgyWE1QSlEvOTY2Q2xMRlJtcmlZTldVbzRNZEdudHVFMG50K09TNmRFMysK",
      "endpoints": ["https://github.com/HurgotDev/pilas-app/releases/latest/download/latest.json"]
    }
  }
}
